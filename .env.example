# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
Direct_connection_str=your-database-connection-string

# Imagekit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=your-imagekit-url-endpoint
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

NEXT_PUBLIC_SITE_NAME=BlueStars

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_JWT_SECRET=your-jwt-secret-key


# analytics Credentials
NEXT_PUBLIC_GA_ID=
# Chatbot (Groq). Server-side only: never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=your-groq-api-key
# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo
